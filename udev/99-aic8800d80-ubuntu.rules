# The pinned upstream installer already ejects the tested a69c:5721 virtual
# disk from its aic.rules file. Keep only the device-scoped Wi-Fi binding here
# so the same disk is not ejected twice.

# Operational Wi-Fi interface. The upstream firmware-loader handles the combo
# device's Bluetooth interfaces; bind interface 2 to the Wi-Fi driver.
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="368b", ATTR{idProduct}=="8d81", ATTR{bInterfaceClass}=="ff", RUN+="/bin/sh -c 'modprobe aic8800_fdrv; echo 368b 8d81 > /sys/bus/usb/drivers/aic8800_fdrv/new_id 2>/dev/null || true'"
